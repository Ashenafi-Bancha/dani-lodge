# Copy to .env and fill in. Never commit the real .env.

PORT=4000

# Website addresses allowed to send enquiries (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Where the SQLite database file is stored
DATABASE_PATH=./data/dani-lodge.db

# Secret key the owner types to open /admin. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway...)
# so rate limiting sees the visitor's real IP.
TRUST_PROXY=0

# Optional: get a Telegram message for every new enquiry.
# Create a bot with @BotFather, then put its token and the chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
